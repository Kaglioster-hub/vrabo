import { NextResponse } from "next/server";

// Nota: Nominatim ha limiti. Usiamo una singola richiesta + normalizzazione.
// Facoltativo: aggiungi una tua chiave/server e fai throttling lato edge.

type Item = { id:string; label:string; sublabel?:string; code?:string; type?:string };

export async function GET(req: Request) {
  const { searchParams } = new URL(req.url);
  const q = (searchParams.get("q") || "").trim();
  const type = (searchParams.get("type") || "place").toLowerCase(); // "place" | "airport"

  if (!q || q.length < 2) return NextResponse.json({ ok:true, items: [] });

  try {
    if (type === "airport") {
      // Semplice euristica: cerca "airport" globalmente (Nominatim)
      const res = await fetch(`https://nominatim.openstreetmap.org/search?format=jsonv2&q=${encodeURIComponent(q+" airport")}&limit=10&addressdetails=1`, {
        headers: { "User-Agent": "vrabo.it/geo-autocomplete" },
        next: { revalidate: 3600 }
      });
      const data = await res.json();
      const items: Item[] = data.map((r: any, i: number) => {
        const label = r.display_name?.split(",")[0] || r.name || r.display_name || q;
        const sub = r.address?.city || r.address?.state || r.address?.country;
        // Non sempre IATA disponibile: lasciamo code vuoto, l’utente può scrivere manualmente
        return { id: r.place_id?.toString() || String(i), label, sublabel: sub, type: "airport" };
      });
      return NextResponse.json({ ok:true, items });
    } else {
      // Luoghi / città
      const res = await fetch(`https://nominatim.openstreetmap.org/search?format=jsonv2&q=${encodeURIComponent(q)}&limit=10&addressdetails=1`, {
        headers: { "User-Agent": "vrabo.it/geo-autocomplete" },
        next: { revalidate: 1800 }
      });
      const data = await res.json();
      const items: Item[] = data.map((r: any, i:number) => {
        const label = r.display_name?.split(",")[0] || r.name || r.display_name || q;
        const sub = r.address?.state || r.address?.country || r.address?.county;
        return { id: r.place_id?.toString() || String(i), label, sublabel: sub, type: r.type || "place" };
      });
      return NextResponse.json({ ok:true, items });
    }
  } catch (e) {
    return NextResponse.json({ ok:true, items: [] });
  }
}
