@tailwind base;
@tailwind components;
@tailwind utilities;

/* ========== BASE THEME ========== */
@layer base{
  :root{
    --bg: #0b0b0b;
    --bg-2:#0f1012;
    --fg: #eaeaea;
    --fg-dim:#c7c7c7;
    --brand:#ffd700;
    --radius:16px;
    --ring:0 0 0 2px rgba(255,215,0,.35);
  }
  html,body{ height:100%; }
  body{
    @apply antialiased;
    background:
      radial-gradient(1200px 600px at 50% -10%, rgba(255,215,0,.08), transparent 60%),
      radial-gradient(800px 500px at 100% 20%, rgba(255,255,255,.06), transparent 60%),
      var(--bg);
    color:var(--fg);
  }
  ::selection{
    background: rgba(255,215,0,.30);
    color: rgba(255,255,255,.95);
  }
}

/* ========== LAYOUT ========== */
.container-hero{ @apply mx-auto max-w-7xl px-4 sm:px-6 lg:px-8; }
.section{ @apply container-hero py-8 sm:py-10 lg:py-12; }

/* Nascondi vecchi overlay/hero/video invasivi */
#hero, .hero, .hero-overlay, .genesi-hero, .bg-spotlight,
video#bg, video.bg, .bg-video, .hero-video { display:none !important; }

/* ========== UI PRIMITIVES ========== */
@layer components{
  .card{
    border:1px solid rgba(255,255,255,.12);
    border-radius:var(--radius);
    background:
      linear-gradient(180deg, rgba(255,255,255,.05), rgba(0,0,0,.18));
    box-shadow: var(--ring), 0 10px 30px rgba(0,0,0,.35);
    backdrop-filter:saturate(120%) blur(6px);
  }
  .glass{
    border:1px solid rgba(255,255,255,.10);
    border-radius:var(--radius);
    background:linear-gradient(180deg, rgba(255,255,255,.06), rgba(0,0,0,.20));
    box-shadow:0 10px 30px rgba(0,0,0,.35);
    backdrop-filter: blur(8px);
  }

  .input{
    appearance:none; outline:none; height:42px;
    border-radius:var(--radius); padding:0 12px;
    border:1px solid rgba(255,255,255,.16);
    background:rgba(255,255,255,.06); color:var(--fg);
    transition:border-color .15s, box-shadow .15s, background .15s;
  }
  .input:hover{ border-color:rgba(255,255,255,.28); }
  .input:focus{ box-shadow:var(--ring); border-color:rgba(255,255,255,.38); background:rgba(255,255,255,.08); }

  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:.5rem;
    height:42px; padding:0 14px; border-radius:var(--radius);
    border:1px solid rgba(255,255,255,.14);
    background:linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.05));
    color:var(--fg); text-decoration:none;
    transition:transform .06s ease, box-shadow .15s, background .15s, border-color .15s;
  }
  .btn:hover{ border-color:rgba(255,255,255,.28); background:linear-gradient(180deg, rgba(255,255,255,.14), rgba(255,255,255,.08)); }
  .btn:active{ transform:translateY(1px); }
  .btn:focus-visible{ box-shadow:var(--ring); outline:none; }
  .btn-primary{
    border-color:rgba(255,215,0,.5);
    background:linear-gradient(180deg, rgba(255,215,0,.88), rgba(255,215,0,.78));
    color:#14120a;
  }
  .btn-ghost{ background:transparent; border-color:rgba(255,255,255,.18); }
  .btn-outline{ background:transparent; border-color:rgba(255,255,255,.35); }
  .btn-sm{ height:34px; padding:0 12px; border-radius:12px; }

  .chip{
    display:inline-flex; align-items:center; gap:.4rem;
    font-size:.78rem; padding:.25rem .55rem; border-radius:.6rem;
    border:1px solid rgba(255,255,255,.14); background:rgba(255,255,255,.06);
  }

  /* Grid helper per cards responsive */
  .grid-auto-fit{ display:grid; grid-template-columns:repeat(auto-fit, minmax(230px,1fr)); gap:18px; }
}

/* ========== PARTNER CARD (glossy + 3D) ========== */
@layer components{
  .partner-card{
    position:relative; display:block; aspect-ratio:1/1; overflow:hidden;
    border-radius:var(--radius);
    border:1px solid rgba(255,255,255,.14);
    background:
      radial-gradient(120% 120% at 10% 0%, rgba(255,255,255,.06), rgba(0,0,0,.18));
    transition: box-shadow .15s, transform .10s, border-color .15s;
    box-shadow:0 12px 28px rgba(0,0,0,.45);
    transform: translateZ(0);
  }
  .partner-card:hover{ box-shadow:var(--ring), 0 20px 40px rgba(0,0,0,.55); border-color:rgba(255,255,255,.25); transform: translateY(-3px); }
  .partner-card:focus-visible{ outline:none; box-shadow:var(--ring); }

  .partner-sheen{ position:absolute; inset:-40%;
    background: radial-gradient(600px 200px at var(--mx,50%) -20%, rgba(255,255,255,.18), transparent 60%);
    filter: blur(10px); opacity:0; pointer-events:none; transition:opacity .2s ease; }
  .partner-card:hover .partner-sheen{ opacity:1; }

  .partner-label{
    position:absolute; left:8px; right:8px; bottom:8px;
    text-align:center; font-size:.85rem; line-height:1.2;
    background:rgba(0,0,0,.35); border:1px solid rgba(255,255,255,.12);
    padding:.35rem .5rem; border-radius:.6rem; text-shadow:0 1px 2px rgba(0,0,0,.6);
  }
  .partner-badge{
    position:absolute; top:8px; right:8px;
    font-size:.7rem; padding:.2rem .45rem; border-radius:.5rem;
    background:rgba(255,215,0,.15); border:1px solid rgba(255,215,0,.45);
  }
  .partner-fallback{
    position:absolute; inset:0; display:grid; place-items:center;
    font-weight:700; font-size:1.4rem; letter-spacing:.04em; color:#fff;
    background:linear-gradient(180deg,#1e293b,#0f172a);
  }
  /* fa sì che i loghi riempiano e restino contenuti */
  .partner-card img, .partner-card picture, .partner-card canvas{
    position:absolute; inset:0; width:100%; height:100%; object-fit:contain;
  }
}
